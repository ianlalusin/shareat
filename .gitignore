# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# secrets
.secrets/

# design-sync tooling (local working state, not project source)
.design-sync/
.ds-sync/
ds-bundle/

# Firestore emulator artifacts
firestore-debug.log
firebase-debug.log

# local git worktrees (subagent-driven-development scratch workspaces)
.worktrees/

# local auth-purge backups (written by scripts/purge-customer-auth-users.ts --write)
.purge-backups/

# Playwright (keyboard-layout test): signed-in state, reports, traces
e2e/.auth/
playwright-report/
test-results/

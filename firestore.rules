rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }
    function staffExists() { return isSignedIn() && exists(staffPath()); }
    function staffData() { return get(staffPath()).data; }
    function isActiveStaff() { return staffExists() && staffData().status == 'active'; }

    // isActiveStaff() (not staffExists()) on the staff-doc branch: a deactivated
    // admin must not keep god access to every store. The platformAdmin custom
    // claim is the break-glass path and stays deliberately un-status-gated, so
    // it still works when the staff-doc branch cannot let anyone through.
    //
    // Grant it with `node scripts/set-platform-admin.mjs <UID>` (Admin SDK, so
    // it needs a service account, not a signed-in user). An earlier version of
    // this comment claimed nothing in the repo called setCustomUserClaims and
    // that the claim was therefore set out of band — that was wrong, and it
    // mattered: it made this branch look like a door nobody could open, which
    // is the reasoning that held back the isActiveStaff() change above.
    //
    // Note: the emulator logs an evaluation error here on deny paths, because
    // `platformAdmin` is absent from every real token and the property read
    // raises instead of returning false. It is verdict-neutral — an errored
    // operand of `||` still yields true when the other side is true, so admins
    // pass and non-admins deny, which is what the rules tests assert. Rewriting
    // it as a keys()/`in` membership test does NOT silence it (verified), so it
    // is left in its original form rather than made more complex for no gain.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.platformAdmin == true ||
        (isActiveStaff() && staffData().role == 'admin')
      );
    }

    // Safe to trust staffData().role here for the same reason isAdmin() is:
    // /staff/{uid} grants update+delete only to isAdmin(), the root fallback
    // denies all writes, and the self-signup create pins role to 'server' and
    // status to 'pending'. A user cannot promote themselves to manager.
    function isManager() {
      return isActiveStaff() && staffData().role == 'manager';
    }
    function isManagerOrAdmin() { return isAdmin() || isManager(); }

    // Writing any of these changes money or the menu, so it is a manager/admin
    // decision. Everything else under a store is operational and stays open to
    // the shift roles. Names here are FIRST path segments only — the catch-all
    // binds {coll} to one segment, so nested docs inherit their parent's verdict
    // (receipts/{id}/revisions/{v} is 'receipts'; storeConfig/current/tables/{t}
    // is 'storeConfig').
    // savedQrCodes is the QR wallet (static merchant QRs shown to customers at
    // the till). It is config, not operational: any staffer may DISPLAY a saved
    // QR, but adding or editing one changes which account receives money, so it
    // is a manager/admin decision.
    //
    // storeConfig is the denormalized cache the cashier UI actually reads at
    // checkout (discounts/charges/modesOfPayment/packages — rebuildStoreConfig()
    // in src/lib/manager/dataManagement.ts writes stores/{id}/storeConfig/current
    // from the manager-gated source collections above). It was missing from this
    // list, which let any store-scoped staffer setDoc a forged 100%-off discount
    // straight into the cache and apply it at the register — see the finding in
    // docs/superpowers/plans/2026-08-12-admin-manager-security-audit.md.
    // Because {coll} only ever binds to the FIRST path segment, gating
    // 'storeConfig' here also covers stores/{id}/storeConfig/current/tables/{t} —
    // an OPERATIONAL live-table-status cache cashiers legitimately write on the
    // checkout path (session start/payment/void). That subcollection is carved
    // back open via its own dedicated match block right after stores/{storeId}
    // below, the same OR-semantics technique used elsewhere in this file.
    //
    // Deliberately NOT listed here: paymentProofs and qrWalletEvents. Cashiers
    // write both on their critical path, and locking them would surface as
    // silent offline data loss (see the note in tests/rules/store-scoped.test.ts).
    function isConfigCollection(coll) {
      return coll in ['inventory', 'storeDiscounts', 'storeCharges', 'storeModesOfPayment',
                      'storePackages', 'storeRefills', 'storeFlavors', 'menuSchedules',
                      'kitchenLocations', 'receiptSettings', 'salesTargets', 'optionOverrides',
                      'savedQrCodes', 'storeConfig'];
    }

    function hasStoreAccess(storeId) {
      return isAdmin() || (
        isActiveStaff()
        && (staffData().assignedStoreIds is list)
        && staffData().assignedStoreIds.hasAny([storeId])
      );
    }

    // -----------------------------
    // CUSTOMER AUTH (via custom token)
    // -----------------------------
    function isCustomer() {
      return isSignedIn() && request.auth.token.customer == true;
    }
    function customerStoreId() { return request.auth.token.storeId; }
    function customerSessionId() { return request.auth.token.sessionId; }

    function isLoyaltyCustomer() {
      return isSignedIn() && request.auth.token.loyaltyCustomer == true;
    }
    function loyaltyPhone() { return request.auth.token.phone; }

    function isCustomerForSession(storeId, sessionId) {
      return isCustomer()
        && customerStoreId() == storeId
        && customerSessionId() == sessionId;
    }
    function customerParticipantId() { return request.auth.token.participantId; }

    function msNow() { return request.time.toMillis(); }

    // -----------------------------
    // OFFLINE SALE / VOID COMPARE-AND-SWAP (audit B16, 2026-10-29)
    // -----------------------------
    // completePaymentOffline / voidSessionOffline build their batch from the
    // device's (possibly stale) cache and stamp a fresh `offlineWriteId` plus
    // `revision = cached + 1` on the session, `releasedByWriteId` +
    // `closedSessionId` on the table docs, and `offlineOrigin` on the receipt.
    // The batch is atomic, so if the session check below fails on reconnect the
    // receipt and table writes are rejected with it. Online paths never write
    // these fields, so they are unaffected. This is a stale-cache guard, not a
    // defence against a hostile client (that needs the server-checkout
    // migration in B01/B16).
    function setsNewValue(field) {
      return (field in request.resource.data)
        && request.resource.data[field] != resource.data.get(field, null);
    }
    // Session doc update: a write that bumps `revision` or carries a new
    // offlineWriteId must start from a still-open session and be exactly one
    // revision ahead of the server copy.
    function offlineSessionWriteOk() {
      return !(setsNewValue('offlineWriteId') || setsNewValue('revision'))
        || (
          !(resource.data.get('status', '') in ['closed', 'voided'])
          && resource.data.get('isPaid', false) != true
          && request.resource.data.get('revision', 0) == resource.data.get('revision', 1) + 1
        );
    }
    // Table doc / live-table projection: an offline release may only clear the
    // table if it still points at the session being closed (another device may
    // have re-seated it during the outage). Never call on delete.
    function tableReleaseOk() {
      return resource == null
        || !setsNewValue('releasedByWriteId')
        || resource.data.get('currentSessionId', null) == request.resource.data.get('closedSessionId', '');
    }
    // Receipt doc: an offline-origin write may create the receipt, or rewrite
    // the same offline receipt (same number), but never replace an online
    // receipt or another terminal's offline receipt. Never call on delete.
    function offlineReceiptWriteOk() {
      return request.resource.data.get('offlineOrigin', false) != true
        || resource == null
        || (
          resource.data.get('offlineOrigin', false) == true
          && resource.data.get('receiptNumber', null) == request.resource.data.get('receiptNumber', null)
        );
    }
    // Uses .get(field, null) rather than direct field access so the guard is safe
    // on documents that have no PIN fields at all — this is applied to the
    // activeSessions wildcard block below, which also matches subcollection docs
    // like customerParticipants, and a missing-field read would error to deny.
    // `resource == null` is the create case. The previous version used
    // !resource.exists(), which raises "Null value error" on create — the guard
    // was doubly broken: it errored here, and the activeSessions wildcard block
    // OR-ed past it anyway, so nothing ever surfaced.
    function pinFieldsUnchanged() {
      return resource == null
        || (
          request.resource.data.get('customerPin', null) == resource.data.get('customerPin', null)
          && request.resource.data.get('customerAccessEnabled', null) == resource.data.get('customerAccessEnabled', null)
          && request.resource.data.get('customerAccessExpiresAtMs', null) == resource.data.get('customerAccessExpiresAtMs', null)
        );
    }

    // Sharelebrator cashier-link fields. They are written ONLY by trusted
    // Admin-SDK routes (/api/loyalty/link-session, the CUSTOMER app), which
    // bypass rules, and no client code writes them. Without this guard any
    // store-scoped staffer could attach an arbitrary customer's phone to a
    // session from devtools, skipping the role check and add-only rule those
    // routes enforce. Same shape as pinFieldsUnchanged(): .get(field, null) so it
    // is safe on docs without the fields (subcollection docs under the wildcard
    // blocks). Update (resource != null): every field must be unchanged. Create
    // (resource == null): none may be present, so a client cannot create a
    // session doc pre-linked. Never call this on delete (request.resource is null).
    function linkFieldsUnchanged() {
      return resource == null
        ? (
          request.resource.data.get('linkedCustomerPhone', null) == null
          && request.resource.data.get('linkedCustomerName', null) == null
          && request.resource.data.get('linkedByParticipantId', null) == null
          && request.resource.data.get('linkedBy', null) == null
          && request.resource.data.get('linkedByUid', null) == null
          && request.resource.data.get('linkedAt', null) == null
          && request.resource.data.get('linkedCustomerLockedAt', null) == null
        )
        : (
          request.resource.data.get('linkedCustomerPhone', null) == resource.data.get('linkedCustomerPhone', null)
          && request.resource.data.get('linkedCustomerName', null) == resource.data.get('linkedCustomerName', null)
          && request.resource.data.get('linkedByParticipantId', null) == resource.data.get('linkedByParticipantId', null)
          && request.resource.data.get('linkedBy', null) == resource.data.get('linkedBy', null)
          && request.resource.data.get('linkedByUid', null) == resource.data.get('linkedByUid', null)
          && request.resource.data.get('linkedAt', null) == resource.data.get('linkedAt', null)
          && request.resource.data.get('linkedCustomerLockedAt', null) == resource.data.get('linkedCustomerLockedAt', null)
        );
    }

    // -----------------------------
    // Collection Group Rules
    // -----------------------------
    // Scoped to the querying user's stores. Collection-group rules are evaluated
    // per returned document, so any client collectionGroup() query over these
    // MUST filter where('storeId','==',...) or it will be denied for non-admins.
    // The only live one, SyncKdsTicketsTool, already does.
    match /{path=**}/kitchentickets/{ticketId} {
      allow read: if isActiveStaff() && hasStoreAccess(resource.data.storeId);
    }
    match /{path=**}/activityLogs/{logId} {
      allow read: if isActiveStaff() && hasStoreAccess(resource.data.storeId);
    }

    // -----------------------------
    // Staff Profiles
    // -----------------------------
    match /staff/{uid} {
      allow read, write: if isAdmin();
      allow get: if isSignedIn() && request.auth.uid == uid;
      // Public self-signup may create ONLY its own non-privileged, pending
      // profile. Role/status/store access are locked here so a signer-up
      // cannot self-elevate to admin or active by writing the doc directly
      // (bypassing the UI). Promotion happens admin-side via the isAdmin write.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'server'
        && request.resource.data.assignedStoreIds == [];
    }

    // -----------------------------
    // PIN REGISTRY (STAFF + CUSTOMER)
    // -----------------------------
    match /pinRegistry/{pin} {
      // CUSTOMER: allow get only if active + not expired
      // (No list, no write)
      allow get: if isCustomer()
        && resource.data.status == 'active'
        && resource.data.expiresAtMs > msNow();

      // STAFF: read only. PIN writes now go through trusted server routes.
      allow get, list: if isActiveStaff() && hasStoreAccess(resource.data.storeId);

      allow create, update, delete: if false;
    }

    // -----------------------------
    // Real-time KDS Projections
    // -----------------------------
    match /stores/{storeId}/rtKdsTickets/{docPath=**} {
      allow read, write: if hasStoreAccess(storeId);
    }

    // -----------------------------
    // Active Sessions Projection
    // -----------------------------
    // Staff access (existing) + Customer read access to ONLY their session doc
    match /stores/{storeId}/activeSessions/{sessionId} {
      allow read: if hasStoreAccess(storeId);
      allow create, update: if hasStoreAccess(storeId) && pinFieldsUnchanged() && linkFieldsUnchanged();
      allow delete: if hasStoreAccess(storeId);

      // CUSTOMER: read only if access enabled + not expired
      allow get: if isCustomerForSession(storeId, sessionId)
        && resource.data.customerAccessEnabled == true
        && resource.data.customerAccessExpiresAtMs > msNow();
    }

    // Customer participants: customers read only their own active doc; staff have full access via wildcard below.
    match /stores/{storeId}/activeSessions/{sessionId}/customerParticipants/{participantId} {
      allow get: if isCustomerForSession(storeId, sessionId)
        && customerParticipantId() == participantId
        && resource.data.status == 'active';
    }

    // Catch-all for staff subpaths under activeSessions. This block also matches
    // the activeSessions/{sessionId} document itself ({docPath=**} covers one or
    // more segments), so it MUST repeat pinFieldsUnchanged() — otherwise it ORs
    // straight past the guard on the block above and the PIN fields are freely
    // forgeable by any store-scoped staff member.
    //
    // Known residual: a client may still delete the session doc and recreate it
    // with arbitrary PIN fields, since !resource.exists() permits any values on
    // create and cashiers legitimately delete activeSessions on payment/void.
    // Closing that requires PIN issuance to move fully server-side.
    //
    // create/update and delete are listed separately on purpose: `write` covers
    // all three, but on a delete `request.resource` is null, so evaluating
    // pinFieldsUnchanged() would error to deny and break every payment and void
    // (both delete the activeSessions doc).
    //
    // linkFieldsUnchanged() is repeated here for the same reason as the PIN guard:
    // this block matches the session doc itself, so omitting it would OR past the
    // link-field lock on the block above.
    match /stores/{storeId}/activeSessions/{docPath=**} {
      allow read: if hasStoreAccess(storeId);
      allow create, update: if hasStoreAccess(storeId) && pinFieldsUnchanged() && linkFieldsUnchanged();
      allow delete: if hasStoreAccess(storeId);
    }

    // sessions carries the same Sharelebrator link fields as activeSessions, so it
    // gets the same lock. It is excluded from the generic store catch-all (write
    // clause) — rules OR across blocks, so leaving it there would hand back the
    // very write this block denies. Reads are still granted by that catch-all.
    // {docPath=**} also covers subcollection docs (sessions/{id}/billLines/...),
    // which have no link fields and pass the guard. create/update and delete are
    // separate for the same reason as above (request.resource is null on delete).
    // closedSessions is deliberately NOT guarded: the cashier client copies
    // projections there at billout.
    //
    // Audit B16 (2026-10-29): the session doc and its subcollections are split
    // so the session doc can carry an offline compare-and-swap, and the
    // session's activityLogs subcollection can be append-only (B01 slice).
    //
    // Audit P1 final: paying / closing / voiding a session (status closed or
    // voided, isPaid, the ownership revision, offline write ids) is a server
    // command. Clients keep every other session write (bill edits, guest
    // counts, approvals, notes...).
    match /stores/{storeId}/sessions/{sessionId} {
      function settlementFieldsUnchanged() {
        return request.resource.data.get('isPaid', false) == resource.data.get('isPaid', false)
          && request.resource.data.get('revision', null) == resource.data.get('revision', null)
          && request.resource.data.get('offlineWriteId', null) == resource.data.get('offlineWriteId', null)
          && (request.resource.data.get('status', '') == resource.data.get('status', '')
              || (!(request.resource.data.get('status', '') in ['closed', 'voided'])
                  && !(resource.data.get('status', '') in ['closed', 'voided'])));
      }
      function isPricingRole() {
        return isManagerOrAdmin() || (isActiveStaff() && staffData().role == 'cashier');
      }
      // Review #1: a new session starts open, unpaid, at ownership revision 1,
      // with no loyalty rewards (server-only, below) and — unless a cashier+
      // creates it — no bill discount or custom adjustments.
      allow create: if hasStoreAccess(storeId) && linkFieldsUnchanged()
        && !(request.resource.data.get('status', '') in ['closed', 'voided'])
        && request.resource.data.get('isPaid', false) != true
        && request.resource.data.get('revision', 1) == 1
        && request.resource.data.get('loyaltyRedemptions', []).size() == 0
        && (isPricingRole() || (
          request.resource.data.get('billDiscount', null) == null
          && request.resource.data.get('customAdjustments', []).size() == 0));
      // Bill-level discounts / custom adjustments are a cashier+ decision (audit
      // P1 follow-up); loyaltyRedemptions is written only by the loyalty server
      // routes and is never client-editable (review #1).
      function billDiscountsUnchangedOrPricingRole() {
        return isPricingRole()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['billDiscount', 'customAdjustments']);
      }
      allow update: if hasStoreAccess(storeId) && linkFieldsUnchanged() && offlineSessionWriteOk()
        && settlementFieldsUnchanged() && billDiscountsUnchangedOrPricingRole()
        && request.resource.data.get('loyaltyRedemptions', null) == resource.data.get('loyaltyRedemptions', null);
      // No client deletes a session (review #1: delete + recreate would reset
      // revision and discounts while the bill lines survive).
      allow delete: if false;
    }
    // Every doc under a session (billLines, payments, kitchentickets, ...).
    // activityLogs is append-only: the timeline and loss-prevention review read
    // it, so a past entry must never be edited or erased. No client updates or
    // deletes it (writeActivityLog only creates).
    // payments (tender rows) are written only by the server checkout command
    // since audit P1.
    //
    // sessionBillLines (audit P1 follow-up, B01 "kitchen/server clients can
    // alter prices"): only cashier / manager / admin accounts may set a price,
    // a modifier total, a price override, a discount or a free quantity on a
    // line. Server and kitchen accounts add lines (the checkout command then
    // proves the price against the store's price list), add quantity, and void
    // through the kitchen cancel flow; they may not lower an add-on line's
    // quantity. A priceOverride is only ever written in the writer's own uid,
    // which is what the checkout command trusts. DEPLOY WITH THE P1 FINAL RULES.
    match /stores/{storeId}/sessions/{sessionId}/{subcoll}/{subPath=**} {
      function canSetPrices() {
        return isManagerOrAdmin() || (isActiveStaff() && staffData().role == 'cashier');
      }
      function ownOverride() {
        return !('priceOverride' in request.resource.data)
          || (resource != null && request.resource.data.priceOverride == resource.data.get('priceOverride', null))
          || request.resource.data.priceOverride.byUid == request.auth.uid;
      }
      function lineCreateOk() {
        return subcoll != 'sessionBillLines' || ownOverride() && (canSetPrices() || (
          !('priceOverride' in request.resource.data)
          && request.resource.data.get('lineAdjustments', {}).size() == 0
          && request.resource.data.get('freeQty', 0) == 0
          && request.resource.data.get('discountValue', 0) == 0
          && request.resource.data.get('discountQty', 0) == 0
          && request.resource.data.get('voidedQty', 0) == 0
          && request.resource.data.get('kitchenVoidedQty', 0) == 0
        ));
      }
      function lineUpdateOk() {
        return subcoll != 'sessionBillLines' || ownOverride() && (canSetPrices() || (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'unitPrice', 'modifiersTotal', 'priceOverride', 'lineAdjustments', 'freeQty',
            'discountType', 'discountValue', 'discountQty', 'discountId', 'itemId', 'type'])
          && (resource.data.get('type', '') == 'package'
              || request.resource.data.get('qtyOrdered', 0) >= resource.data.get('qtyOrdered', 0))
          // Review #3: server / kitchen voids only through the kitchen cancel
          // flow, which moves voidedQty and kitchenVoidedQty by the same amount;
          // checkout bounds kitchenVoidedQty by cancelled kitchen tickets.
          && request.resource.data.get('voidedQty', 0) - resource.data.get('voidedQty', 0)
             == request.resource.data.get('kitchenVoidedQty', 0) - resource.data.get('kitchenVoidedQty', 0)
          && request.resource.data.get('kitchenVoidedQty', 0) >= resource.data.get('kitchenVoidedQty', 0)
        ));
      }
      allow create: if hasStoreAccess(storeId) && linkFieldsUnchanged() && subcoll != 'payments' && lineCreateOk();
      allow update: if hasStoreAccess(storeId) && linkFieldsUnchanged() && !(subcoll in ['activityLogs', 'payments']) && lineUpdateOk();
      allow delete: if hasStoreAccess(storeId) && !(subcoll in ['activityLogs', 'payments'])
        && (subcoll != 'sessionBillLines' || canSetPrices());
    }

    match /stores/{storeId}/closedSessions/{docPath=**} {
      allow read, write: if hasStoreAccess(storeId);
    }

    // -----------------------------
    // FLASH ADS (CUSTOMER-VISIBLE PROMOS)
    // -----------------------------
    // The only collection the customer Hub reads straight from Firestore
    // instead of through an Admin-SDK route (see CUSTOMER
    // src/app/dashboard/page.tsx). It had no rule at all here, so every Hub
    // load logged a permission-denied and diners never saw an ad — the promo
    // silently did nothing. Staff read/write is already covered by the
    // stores/{storeId}/{coll} catch-all below; this block adds only the
    // customer's own read.
    //
    // `list` as well as `get`: the Hub fetches its store's ads in one query.
    // Firestore can only satisfy a rule that inspects resource.data on a query
    // constrained the same way, so the Hub MUST ask for
    // where('active','==',true). An unfiltered read stays denied by design —
    // that is precisely what stops a draft ad reaching a paying diner, so do
    // not "fix" a future denial by dropping the active check here.
    match /stores/{storeId}/flashAds/{adId} {
      allow get, list: if isCustomer()
        && customerStoreId() == storeId
        && resource.data.active == true;
    }

    // The store document itself (kept separate so the collection-scoped rule
    // below can inspect the top-level collection name as a plain string).
    // Write/delete require isManagerOrAdmin(): this doc holds taxRatePct, tin,
    // isActive, acceptsOnlineOrders/acceptsReservations, loyaltyConfig and
    // forecastConfig — hasStoreAccess() alone let any cashier/server/kitchen
    // assigned to the store rewrite or delete it straight from a devtools
    // console (RoleGuard on /admin/stores and /manager/store-settings is
    // UI-only). See docs/superpowers/plans/2026-08-12-admin-manager-security-audit.md.
    match /stores/{storeId} {
      allow read: if hasStoreAccess(storeId);
      allow write, delete: if hasStoreAccess(storeId) && isManagerOrAdmin();
    }

    // Carve-out for the operational live-table-status cache nested under the
    // now-manager/admin-gated storeConfig collection (see isConfigCollection()
    // above) — cashiers update this on session start/payment/void
    // (src/components/cashier/firestore.ts, offlinePayment.ts, offlineVoid.ts)
    // and it's rebuilt wholesale by rebuildStoreConfig() alongside
    // storeConfig/current. Only this exact subpath is reopened; storeConfig/current
    // itself (the pricing/discount/charge cache) stays manager/admin-only via the
    // catch-all below.
    match /stores/{storeId}/storeConfig/current/tables/{tableId} {
      allow read: if hasStoreAccess(storeId);
      // tableReleaseOk(): offline release must still match the seated session
      // (audit B16). Residual: managers/admins also pass the storeConfig
      // catch-all, which ORs past this guard for them.
      // Audit P1 final: releasing a seated table is a server command (checkout /
      // void / offline reconcile). Managers keep the wholesale rebuild via the
      // storeConfig catch-all (existing residual).
      function projectionReleaseDenied() {
        return resource != null
          && resource.data.get('currentSessionId', null) != null
          && (request.resource.data.get('currentSessionId', null) == null
              || (request.resource.data.get('status', '') == 'available'
                  && resource.data.get('status', '') != 'available'));
      }
      allow create, update: if hasStoreAccess(storeId) && tableReleaseOk() && !projectionReleaseDenied();
      allow delete: if hasStoreAccess(storeId);
    }

    // -----------------------------
    // CHECKOUT RECORDS (audit B01 first slice + B16, 2026-10-29)
    // -----------------------------
    // These collections are excluded from the catch-all's write grant below
    // (rules OR across blocks, so they must be) and written only through these
    // blocks. Reads still come from the catch-all.
    //
    // receipts: no client ever deletes one — voids and refunds append status /
    // a refund receipt instead. Deleting a paid receipt erased the sale from
    // every report, so delete is denied. create/update stay open (online and
    // offline checkout, print counter, edits, voids, refunds, analytics flags)
    // with the offline overwrite guard.
    //
    // Audit P1 final (B01 / NOV-RECEIPTS): receipts, refund receipts, voids,
    // corrections and every analytics flag on them are written ONLY by the
    // server commands (/api/pos/commands/*, Admin SDK). The one client write
    // left is the print audit (use-print.ts): exactly those four fields, with
    // printedCount advancing by one. Revision snapshots are server-only (no
    // block below grants them, and the catch-all excludes receipts).
    // DEPLOY ONLY AFTER EVERY TILL RUNS THE P1 APK — older builds write
    // receipts directly and would fail checkout.
    match /stores/{storeId}/receipts/{receiptId} {
      function printAuditOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['printedCount', 'lastPrintedAt', 'lastPrintedByUid', 'lastPrintedByUsername'])
          && request.resource.data.get('printedCount', 0) == resource.data.get('printedCount', 0) + 1;
      }
      allow update: if hasStoreAccess(storeId) && printAuditOnly();
    }

    // tables: releasing a seated table (clearing currentSessionId, or flipping
    // it to available) is a server command since audit P1, so an old offline
    // settlement can never free a table another till re-seated. Seating
    // (startSession) and manager edits (name / active) stay client writes.
    match /stores/{storeId}/tables/{docPath=**} {
      function tableReleaseDenied() {
        return resource != null
          && resource.data.get('currentSessionId', null) != null
          && (request.resource.data.get('currentSessionId', null) == null
              || (request.resource.data.get('status', '') == 'available'
                  && resource.data.get('status', '') != 'available'));
      }
      allow create, update: if hasStoreAccess(storeId) && tableReleaseOk() && !tableReleaseDenied();
      allow delete: if hasStoreAccess(storeId);
    }

    // counters/receipts is the receipt-number sequence. Since audit P1 only the
    // server checkout command advances it; no client write at all (the
    // catch-all excludes counters).
    match /stores/{storeId}/counters/{counterId} {
      allow create, update, delete: if false;
    }

    // -----------------------------
    // OFFLINE POS COMMANDS (audit P1: B16/B17, 2026-11-03)
    // -----------------------------
    // An offline till records each sale / void as an immutable command that
    // the server applies on reconnect (/api/pos/commands/reconcile and the
    // reconcile-pos-commands cron). Clients may only CREATE their own command:
    // no read (it carries the operator's signed session token, which a
    // colleague could otherwise replay), no update, no delete. A second setDoc
    // on the same id is an update and is denied, so a command cannot be
    // rewritten after the fact. Outcomes live in posCommandResults
    // (server-written, staff-readable); the effects outbox posEffects is
    // server-only (its payloads include customer PINs). All three are excluded
    // from the catch-all below.
    match /stores/{storeId}/posCommands/{opId} {
      allow create: if hasStoreAccess(storeId)
        && request.resource.data.schema == 1
        && request.resource.data.opId == opId
        && request.resource.data.storeId == storeId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.kind in ['checkout', 'voidSession']
        // Review #7: the server sweep indexes unresolved commands; a client may
        // not create one pre-resolved to hide it from the sweep.
        && request.resource.data.resolved == false;
    }
    match /stores/{storeId}/posCommandResults/{opId} {
      allow read: if hasStoreAccess(storeId);
    }

    // Activity / audit logs are append-only: the only client writers
    // (writeActivityLog, lib/firebase/activity-log.ts) only create. Without
    // this any shift role could rewrite or erase the record of a void.
    match /stores/{storeId}/activityLogs/{docPath=**} {
      allow create: if hasStoreAccess(storeId);
    }
    match /stores/{storeId}/activityLogsByDay/{docPath=**} {
      allow create: if hasStoreAccess(storeId);
    }

    // -----------------------------
    // CHAT PRESENCE LOG (append-only)
    // -----------------------------
    // Who was signed in on a cashier station at each moment. The chat-response
    // scorer replays this log to decide whose performance score a slow or
    // unanswered customer message lands on, so a past event must never be
    // editable or erasable — rewriting one retroactively rewrites who was on
    // duty, and with it someone's rating. Same reasoning as paymentIntents
    // below ("a cashier device cannot forge a 'paid' status"), applied to the
    // record instead of the status.
    //
    // create stays open to any store-scoped staff: ChatInbox writes these
    // straight from the client on every profile change, and it is exactly the
    // grant the catch-all already gave. read likewise stays open (on-duty
    // display and debugging; low sensitivity).
    //
    // NOTE: `allow update, delete: if false` here is not self-sufficient —
    // rules OR across every matching block, so the catch-all below would grant
    // them straight back. chatPresenceLog is therefore ALSO excluded from the
    // catch-all's write/delete list; both halves are required for the
    // append-only guarantee to hold. Do not remove one without the other.
    match /stores/{storeId}/chatPresenceLog/{eventId} {
      allow read: if hasStoreAccess(storeId);
      allow create: if hasStoreAccess(storeId);
      allow update, delete: if false;
    }

    // Store scoped (everything else). Analytics rollups
    // (analytics / analyticsMonths / analyticsYears / dashPresets / dailySessions)
    // are SERVER-ONLY
    // writes: every writer goes through the admin SDK (which bypasses these rules),
    // so clients may READ them but not write/delete. `coll` is a single-segment
    // wildcard (a string), so the membership check is unambiguous.
    //
    // The online storefront collections are likewise server-only writes: the
    // catalog snapshot + config are built by the admin API, online orders are
    // created by the website Cloud Function and advanced by the transition API.
    // Staff may READ them (the Online Orders inbox listens live) but never write.
    //
    // paymentIntents (PayMongo QR Ph bridge docs) are also server-only writes:
    // created by the create-qr route and advanced by the PayMongo webhook (the
    // webhook is the source of truth for status). Staff may READ them (to show
    // the live QR/payment status on the POS) but never write, so a cashier
    // device cannot forge a "paid" status.
    //
    // Config collections (isConfigCollection above) are further restricted to
    // managers and admins. hasStoreAccess() alone does not distinguish roles, so
    // without this a cashier or server could rewrite selling prices, discounts,
    // charges, or payment methods straight from a devtools console — the
    // manager-only restriction on /manager/inventory and /manager/store-settings
    // is RoleGuard, i.e. UI-only. Operational collections stay open: a shift
    // cannot run otherwise, and a denied offline replay is silent data loss
    // (commitLocalFirst does not await the commit).
    //
    // activeSessions is excluded entirely: it has dedicated blocks above that
    // cover read/create/update/delete, and this catch-all would otherwise OR
    // straight past their pinFieldsUnchanged() guard, leaving the customer PIN
    // fields forgeable by any store-scoped staff member.
    //
    // serverProfileSecrets is excluded from READ as well as write — the only
    // store-scoped collection that is. It holds the hashed passcodes for local
    // device profiles, which are 6 digits, so a readable hash is a sub-second
    // offline crack and lets anyone act on a shared tablet under a colleague's
    // name. Note this exclusion has to live in the catch-all condition itself:
    // a separate `match … { allow read: if false }` block would do nothing,
    // because rules OR across every matching block. /api/server-profiles reads
    // and writes it through the Admin SDK.
    match /stores/{storeId}/{coll}/{docPath=**} {
      allow read: if hasStoreAccess(storeId)
        && coll != 'serverProfileSecrets'
        // posCommands / posEffects: see OFFLINE POS COMMANDS above.
        && !(coll in ['posCommands', 'posEffects']);
      allow write, delete: if hasStoreAccess(storeId)
        && coll != 'activeSessions'
        // sessions has a dedicated block above (link-field guard); see its comment.
        && coll != 'sessions'
        && coll != 'serverProfileSecrets'
        // serverProfiles (local device profiles) is client-read-only. Every
        // create/rename/reset/delete goes through /api/server-profiles (Admin
        // SDK), which enforces manager-only delete/reset and name uniqueness.
        // Left writable here, any shift role could delete or rename a
        // colleague's profile, or plant a legacy `passcodeHash` the verifier
        // still accepts for unmigrated profiles (audit B20, 2026-10-29). No
        // client code writes this collection (ServerProfilesManagerCard and
        // ServerProfileSwitcher only read it and call the API).
        && coll != 'serverProfiles'
        // chatPresenceLog has its own block above making it append-only
        // (create yes, update/delete never). Because rules OR, leaving it in
        // here would hand back the very update/delete that block denies, and a
        // staff member could retroactively rewrite who was on duty when a
        // customer message went unanswered — i.e. edit a colleague's (or their
        // own) performance score. create is still granted by that block.
        && coll != 'chatPresenceLog'
        // Checkout records with dedicated blocks above (audit B01/B16): receipts
        // (no delete, offline overwrite guard), tables (offline release guard),
        // counters (monotonic), activity logs (append-only).
        && !(coll in ['receipts', 'tables', 'counters', 'activityLogs', 'activityLogsByDay'])
        // Offline POS commands (create-only block above) and their server-only
        // results / effects outbox (audit P1).
        && !(coll in ['posCommands', 'posCommandResults', 'posEffects', 'tenderConsumptions'])
        // paymentConversions: written only by /api/analytics/payment-conversion
        // (audit P1 final).
        && coll != 'paymentConversions'
        // catalogCache (CUSTOMER app menu/price cache, written by
        // rebuildCustomerCatalog) and inventoryCache (the internal shared
        // inventory-scan cache both rebuildCustomerCatalog and
        // rebuildStorefrontCatalog read from — see
        // src/lib/server/store-inventory-cache.ts) are added here alongside
        // their sibling storefrontCatalog: all three are server-derived caches
        // that feed either a paying customer's menu or another cache, so a
        // client write to any of them would let a lower-privilege store role
        // (cashier/server/kitchen — hasStoreAccess() alone, not
        // isManagerOrAdmin()) inject fake items/prices past every server-side
        // validation rebuildCustomerCatalog/rebuildStorefrontCatalog apply.
        // catalogCache was a pre-existing gap here (missing since it was
        // introduced) — found while adding inventoryCache to this same list.
        // forecastModel: server-learned forecast factors — Admin SDK only.
        && !(coll in ['analytics', 'analyticsMonths', 'analyticsYears', 'dashPresets', 'dailySessions',
                      'storefrontCatalog', 'storefrontConfig', 'onlineOrders', 'paymentIntents',
                      'catalogCache', 'inventoryCache', 'forecastModel'])
        && (!isConfigCollection(coll) || isManagerOrAdmin());
    }

    // PayMongo intent -> bridge-doc reverse index (server-only; written by create-qr,
    // read by the webhook via Admin SDK, which bypasses rules).
    match /paymongoIntentIndex/{intentId} {
      allow read, write, delete: if false;
    }

    // -----------------------------
    // SHARELEBRATOR AUDIT LOG (server-only writes)
    // -----------------------------
    match /loyaltyLogs/{logId} {
      // Cross-branch PII (phone + name of every customer, every store). Managers
      // get their own store's slice through /api/loyalty/store-customers, which
      // reads these with the Admin SDK; direct client listing is admin-only.
      allow read, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Daily projection for the audit log (server-only writes)
    // Doc ID shape: {dayId}_{partIndex} or {dayId}_meta
    match /loyaltyLogsDaily/{docId} {
      // Same cross-branch PII as loyaltyLogs — see above.
      allow read, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // -----------------------------
    // SHARELEBRATOR AGGREGATES (server-only writes)
    // Single projection doc: loyaltyStats/global
    // -----------------------------
    match /loyaltyStats/{docId} {
      allow read: if isActiveStaff();
      allow create, update, delete: if false;
    }

    // -----------------------------
    // LEGACY (PRE-HUB) LOYALTY CUSTOMERS
    // -----------------------------
    // server-only; staff reach it through /api/loyalty/legacy
    match /legacyLoyaltyCustomers/{id} {
      allow read, list, create, update, delete: if false;
    }

    // -----------------------------
    // SHARELEBRATOR LOYALTY CUSTOMERS
    // Top-level (cross-branch). Server-only writes via Admin SDK.
    // -----------------------------
    match /customers/{phone} {
      // Staff no longer read customer docs directly (audit B05, 2026-10-29):
      // the doc carried passwordHash and cross-branch PII, and an exact-phone
      // get is still targeted lookup/enumeration. Staff reach customers only
      // through scoped Admin-SDK routes (/api/loyalty/visit-count, lookup,
      // find-customer, store-customers). The card holder may read their own
      // doc; admins keep get to match their list access.
      allow get: if (isLoyaltyCustomer() && loyaltyPhone() == phone) || isAdmin();
      // list IS enumeration of the whole cross-branch customer base. Store-scoped
      // staff go through /api/loyalty/store-customers instead.
      allow list: if isAdmin();
      allow create, update, delete: if false;

      // No POS/ERP/website client reads the ledger; CUSTOMER reads it server-side.
      match /pointsLedger/{ledgerId} {
        allow get, list: if (isLoyaltyCustomer() && loyaltyPhone() == phone) || isAdmin();
        allow create, update, delete: if false;
      }

      // Password hash + auth secrets (customers/{phone}/secrets/auth). Admin
      // SDK only — not even the card holder or an admin client. The root read
      // fallbacks already skip the whole `customers` tree, so this deny is not
      // undone by OR. See src/lib/server/customer-secrets.ts.
      match /secrets/{secretId} {
        allow read, write: if false;
      }
    }

    // -----------------------------
    // SHARELEBRATOR REWARDS CATALOG + REDEMPTIONS
    // -----------------------------
    // Global rewards catalog: readable by staff (POS cashier UI) and loyalty /
    // session customers (Hub); writable only by platform admins.
    match /loyaltyRewards/{rewardId} {
      allow read, list: if isActiveStaff() || isLoyaltyCustomer() || isCustomer();
      allow create, update, delete: if isAdmin();
    }

    // Redemption records / vouchers — created, validated, and applied
    // server-side via the Admin SDK only.
    match /loyaltyRedemptions/{id} {
      allow read, list, create, update, delete: if false;
    }

    // -----------------------------
    // PLATFORM-WIDE (UNIVERSAL) DISCOUNTS & CHARGES
    // Admins create/update/delete; any active staff can read (POS/manager views need them).
    // -----------------------------
    match /globalDiscounts/{discountId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }
    match /globalCharges/{chargeId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------
    // PLATFORM-WIDE MENU CATALOGS
    // POS clients read these directly; writes are admin-only.
    // Customer-app backends using Admin SDK bypass these rules.
    // -----------------------------
    match /packages/{packageId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }
    match /refills/{refillId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }
    match /flavors/{flavorId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }
    match /products/{productId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }
    match /addonCategories/{categoryId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------
    // PRODUCT REGISTRATION REQUESTS
    // A manager applies for a new global product from /manager/product-requests;
    // a platform admin approves (which creates products/{id} and auto-imports it
    // into the requesting store) or declines with a reason.
    //
    // EVERY write goes through POST /api/product-requests (Admin SDK, which
    // bypasses these rules), so clients are strictly read-only here. A requester
    // must never be able to forge `status`, `requestedByUid`, `nameKey`,
    // `approvedProductId`, or the reviewer fields by writing the doc directly.
    //
    // NOTE: the read grant below is already implied by the root fallback at the
    // bottom of this file (rules are OR-ed across matching blocks). It is spelled
    // out here for the explicit write denial and so the collection is documented
    // alongside the other platform-wide catalogs.
    // -----------------------------
    match /productRequests/{requestId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if false;
    }

    // -----------------------------
    // PRODUCT PHOTO REQUESTS (item photo local/global review workflow)
    // A manager uploads a photo for an item at their store; an admin promotes
    // it to be every store's default (products/{id}.imageUrl) or rejects it.
    // requestId is `${storeId}_${productId}` — one active request per pair.
    //
    // EVERY write goes through POST /api/product-photo-requests (Admin SDK,
    // bypasses these rules) — clients are strictly read-only here, same as
    // productRequests just above. Review fields (status, reviewedBy*) must
    // never be forgeable by a direct client write.
    // -----------------------------
    match /productPhotoRequests/{requestId} {
      allow read, list: if isActiveStaff();
      allow create, update, delete: if false;
    }

    // Legacy user profiles can be read only by admins for migration tools.
    match /users/{userId} {
      allow read, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Root fallback: read-only for authenticated staff. Do not grant writes here,
    // otherwise this fallback can override server-only collection rules above.
    // paymongoIntentIndex is server-only (Admin SDK): exclude it from this read grant,
    // otherwise the OR-semantics of this fallback would expose its correlation docs.
    //
    // 'stores' is excluded from BOTH fallbacks. Without that exclusion the deep
    // fallback matched stores/{anyStoreId}/{anything} with no hasStoreAccess
    // check, so any active staff member could read every store's receipts,
    // sessions and analytics. Store data is governed by the store-scoped blocks
    // above; admins still reach every store because isAdmin() short-circuits
    // hasStoreAccess().
    //
    // 'system' is excluded for the same reason: it holds server-only cron
    // bookkeeping (forecastCronLog, dailyMetricsCronLog, holidayCronLog,
    // activeStoresCache) written exclusively by the Admin SDK, which bypasses
    // these rules entirely. No client ever needs to read it, and
    // activeStoresCache in particular mirrors the full active-store directory
    // (name/address/geo/hours) that the 'stores' exclusion above deliberately
    // keeps scoped to hasStoreAccess() — leaving 'system' open here would have
    // let any active staff member read every other store's info through the
    // cache doc, regardless of store assignment.
    //
    // 'legacyLoyaltyCustomers' is excluded for the paymongoIntentIndex reason:
    // its own block above says `if false`, but rule evaluation is OR, so the
    // explicit deny does nothing unless this fallback also skips it. The rows
    // carry names, emails and visit history of pre-Hub customers.
    //
    // 'loyaltyRedemptions' and 'pinRegistry' are excluded for the same OR reason
    // (audit B06, 2026-10-29). Without it the fallback handed every active
    // staffer every voucher code + customer phone (loyaltyRedemptions' own
    // block is `if false`) and every OTHER store's live table PINs (pinRegistry's
    // own block scopes staff reads to hasStoreAccess(resource.data.storeId)).
    // No client reads loyaltyRedemptions; pinRegistry staff/customer reads keep
    // working through its dedicated block.
    //
    // 'staff' is excluded too: colleagues' names now come from /api/staff/names,
    // so /staff/{uid}'s own block (admin, or get-own-doc) is the only reader.
    match /{collection}/{docId} {
      allow read: if isActiveStaff()
        && collection != 'paymongoIntentIndex'
        && collection != 'stores'
        && collection != 'system'
        && collection != 'customers'
        && collection != 'loyaltyLogs'
        && collection != 'loyaltyLogsDaily'
        && collection != 'legacyLoyaltyCustomers'
        && collection != 'loyaltyRedemptions'
        && collection != 'pinRegistry'
        && collection != 'staff';
      allow create, update, delete: if false;
    }
    match /{collection}/{docId}/{docPath=**} {
      // `{docPath=**}` matches zero-or-more segments (rules_version '2'), so
      // this block also matches collection/docId ITSELF, not just subpaths —
      // it must carry every exclusion the block above does, or a doc denied
      // by an explicit `allow read: if false` elsewhere (paymongoIntentIndex)
      // stays reachable through this fallback via OR-semantics. Confirmed via
      // emulator: without this exclusion, an active staff member's getDoc on
      // paymongoIntentIndex/{id} succeeds despite the explicit deny below.
      allow read: if isActiveStaff()
        && collection != 'paymongoIntentIndex'
        && collection != 'stores'
        && collection != 'system'
        && collection != 'customers'
        && collection != 'loyaltyLogs'
        && collection != 'loyaltyLogsDaily'
        && collection != 'legacyLoyaltyCustomers'
        && collection != 'loyaltyRedemptions'
        && collection != 'pinRegistry'
        && collection != 'staff';
      allow create, update, delete: if false;
    }
  }
}

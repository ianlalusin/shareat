# Names only. Copy the real values into ../.env.test.local (git ignores it). Never commit values.
# Every run writes to TEST_STORE_ID only. Use a store that exists for testing, never a trading branch.

# Cashier-role account assigned to the test store (not an admin or manager).
TEST_CASHIER_EMAIL=
TEST_CASHIER_PASSWORD=
# Dedicated local user (server profile) on the test store, signed in after the cashier login.
# Profile name exactly as shown in "Who's using this tablet?", and its 6-digit passcode.
TEST_OPERATOR_PROFILE=
TEST_OPERATOR_PASSCODE=
# Store id of the TEST store (the id the app keeps under localStorage "activeStoreId"),
# and its exact name as shown in the header. The run stops if that name is not the active store.
TEST_STORE_ID=
TEST_STORE_NAME=
# Leave empty when the test store offers both Unlimited and Ala Carte (tabs shown).
# Set to "alacarte" only if the test store is deliberately ala-carte-only.
TEST_STORE_ORDER_MODES=
# Manager account on the test store. Used only to void the ZZ-TEST sessions the test creates.
TEST_CLEANUP_MANAGER_EMAIL=
TEST_CLEANUP_MANAGER_PASSWORD=
# Exact title of an add-on family with variants on the test store, as shown on its tile.
TEST_VARIANT_ITEM=

# This browser run proves the pinned layout in a short window only. The real Android
# keyboard (resize, Back, rotation) stays a separate manual pass on the tablet with the
# APK: docs/qa/cashier-device-checklist.md. Do not tick that checklist from this run.

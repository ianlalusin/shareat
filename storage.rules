
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // -- Helper Functions --
    // Cross-service Firestore reads from Storage rules must go through the
    // `firestore.` namespace. A bare get() is Firestore-rules syntax: the
    // compiler only warns ("Invalid function name: get"), but at evaluation
    // time the call fails and every rule depending on it falls through to
    // deny — which silently blocked the Items/ and loyaltyRewardImages/
    // uploads below.
    //
    // Audit B22: every staff helper below also requires the token's sign-in
    // (auth_time, epoch seconds) to be after staff/{uid}.tokensValidAfter, the
    // server-owned boundary the admin reset-password route writes right after
    // revokeRefreshTokens(). Storage rules cannot see Firebase's revocation
    // list, so without this a pre-reset token kept uploading for up to an hour.
    // The legitimate user signs in again after the reset and gets a newer
    // auth_time. Missing field = never reset = no fence (-1 default, see
    // tokenNotRevoked() in firestore.rules). The role-only helpers now also
    // require status == 'active', like their firestore.rules counterparts.
    function tokenNotRevoked(d) {
      return request.auth.token.auth_time > d.get('tokensValidAfter', -1);
    }

    function isManagerOrAdmin(uid) {
      let d = staffDataFor(uid);
      return d.status == 'active' && tokenNotRevoked(d)
        && (d.role == 'admin' || d.role == 'manager');
    }

    function isAdmin(uid) {
      let d = staffDataFor(uid);
      return d.status == 'active' && tokenNotRevoked(d) && d.role == 'admin';
    }

    // Store-scoped variants. The role-only helper above is fine for global
    // assets (product images, loyalty rewards) but not for per-store uploads:
    // without the membership check, a manager at one branch could write into
    // another branch's folder. These mirror hasStoreAccess()/isManagerOrAdmin()
    // in firestore.rules, including the status == 'active' gate so a
    // deactivated account cannot keep uploading.
    function staffDataFor(uid) {
      return firestore.get(/databases/(default)/documents/staff/$(uid)).data;
    }

    function hasStoreAccess(uid, storeId) {
      let d = staffDataFor(uid);
      return d.status == 'active' && tokenNotRevoked(d)
        && (d.role == 'admin'
            || (d.assignedStoreIds is list && d.assignedStoreIds.hasAny([storeId])));
    }

    function isStoreManagerOrAdmin(uid, storeId) {
      let d = staffDataFor(uid);
      return d.status == 'active' && tokenNotRevoked(d)
        && (d.role == 'admin'
            || (d.role == 'manager'
                && d.assignedStoreIds is list
                && d.assignedStoreIds.hasAny([storeId])));
    }

    // Content-type and size gate. Without this, "upload an image" is really
    // "upload anything up to the bucket limit".
    function isImageUnder(maxMb) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < maxMb * 1024 * 1024;
    }

    // Default: deny everything. This used to be `allow read` over the whole
    // bucket, which made every object -- payment-proof screenshots included --
    // publicly readable AND listable by anyone with the bucket name (audit B18,
    // 2026-10-29). Storage rules OR across matching blocks, so no narrower
    // proof rule could take that back; the grant itself had to go.
    //
    // Reads are now granted per prefix below, `get` only, never `list`.
    // Public assets keep an anonymous `get` so nothing that fetches them by
    // path breaks. Images shown in the apps use download-token URLs from
    // getDownloadURL(), which bypass these rules entirely; the `get` grant is
    // what the uploader's own getDownloadURL() call needs.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow a user to write/update their own avatar. Revocation-fenced (B22)
    // when the user has a staff doc, so a pre-reset token cannot keep writing
    // here; accounts with no staff doc have no boundary and are unchanged.
    match /users/{userId}/avatar.jpg {
      allow get;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!firestore.exists(/databases/(default)/documents/staff/$(userId))
            || tokenNotRevoked(staffDataFor(userId)));
    }
    
    // Allow only managers or admins to upload product images.
    match /Items/{productId} {
      allow get;
      allow write: if request.auth != null && isManagerOrAdmin(request.auth.uid);
    }

    // Loyalty reward photos — admin only, matching loyaltyRewards' own
    // create/update/delete gate in firestore.rules (isAdmin() there, not
    // isManagerOrAdmin()). This used to be isManagerOrAdmin(), which let a
    // manager upload images under any (including nonexistent) rewardId even
    // though they can never attach one to a real reward via the UI — see
    // docs/superpowers/plans/2026-08-12-admin-manager-security-audit.md.
    match /loyaltyRewardImages/{rewardId}/{fileName} {
      allow get;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Local per-store item photos, pending admin review (see
    // /api/product-photo-requests). Path is store-scoped so two stores
    // uploading a photo for the same product never collide on one object;
    // promoting one just points products/{id}.imageUrl at this same URL,
    // no file copy needed.
    //
    // {fileName} is a per-submission crypto.randomUUID() (same convention as
    // paymentProofs below), NOT a deterministic name. That matters: once an
    // admin promotes a store's photo, products/{id}.imageUrl points at this
    // exact object, so a manager replacing their local photo must land on a
    // NEW object — otherwise the replacement would silently overwrite (and
    // hijack) every store's global picture.
    //
    // The UUID is only a UI convention, so the rule enforces it: CREATE only
    // (resource == null). Overwriting or deleting an existing object -- e.g. the
    // one an admin already promoted to products/{id}.imageUrl -- is denied for
    // every client (audit B19, 2026-10-29). Cleanup is Admin SDK only.
    match /productPhotos/{productId}/{storeId}/{fileName} {
      allow get;
      allow create: if request.auth != null
        && resource == null
        && isStoreManagerOrAdmin(request.auth.uid, storeId)
        && isImageUnder(4);
    }

    // Proposed product photos attached to a product-registration request.
    // Uploaded by the requesting manager before the request doc exists, under a
    // client-generated requestId; the approve op copies the resulting download
    // URL onto products/{id}.imageUrl and the store's inventory record.
    match /productRequestImages/{requestId}/{fileName} {
      allow get;
      allow write: if request.auth != null && isManagerOrAdmin(request.auth.uid);
    }

    // -- QR wallet (saved static merchant QRs) --
    // BRAND ICONS ONLY. No photograph of a QR is ever stored: the wallet keeps
    // the scanned EMVCo payload and regenerates the code, so there is nothing
    // to upload but the tile's logo. Adding a QR decides which account receives
    // money, so manager/admin only — matching savedQrCodes in firestore.rules.
    match /stores/{storeId}/qrWallet/{qrId}/{fileName} {
      allow get;
      allow write: if request.auth != null
        && isStoreManagerOrAdmin(request.auth.uid, storeId)
        && isImageUnder(6);
    }

    // -- Flash ad images (CUSTOMER app promo overlay) --
    // Uploaded by FlashAdsPanel, shared by /admin/flash-ads (admin) and
    // /manager/ads (branch manager) in the CUSTOMER repo. This path had no
    // match block at all, so every upload fell through to the deny-all root
    // rule below and failed for every role, admin included, with no message
    // in the UI other than a failed save. Manager/admin + store membership,
    // matching who can actually reach those two pages.
    match /flashAdImages/{storeId}/{fileName} {
      allow get;
      allow write: if request.auth != null
        && isStoreManagerOrAdmin(request.auth.uid, storeId)
        && isImageUnder(4);
    }

    // -- Payment proofs --
    // Photo of the customer's e-wallet confirmation screen, taken after they
    // scan a saved QR. ANY active store staffer may create one: this is
    // the CASHIER's flow, and gating it to managers would break it on the
    // critical path. CREATE only (resource == null): a proof is immutable once
    // written, so a second upload to an existing key and any client delete are
    // denied (audit B19, 2026-10-29). The 15-day lifecycle rule cleans up.
    //
    // TOP-LEVEL prefix ON PURPOSE, not stores/{storeId}/paymentProofs/. These
    // objects are deleted after 15 days by a Storage lifecycle rule, and
    // lifecycle rules match a LITERAL prefix — with the store id in the middle
    // of the path, no single prefix could target every store's proofs without
    // also matching that store's logo. See storage-lifecycle.json.
    //
    // READ: these photos show a customer's payment confirmation, so there is
    // no public read and no listing -- only an active staffer of THAT store may
    // `get` one (the cashier's own getDownloadURL() right after upload needs
    // this). Residual (audit B18): download-token URLs already saved on
    // stores/{id}/paymentProofs docs bypass these rules until the object
    // expires (15 days) or its token is revoked server-side.
    match /paymentProofs/{storeId}/{fileName} {
      allow get: if request.auth != null
        && hasStoreAccess(request.auth.uid, storeId);
      allow create: if request.auth != null
        && resource == null
        && hasStoreAccess(request.auth.uid, storeId)
        && isImageUnder(6);
    }

    // -- Store logos --
    // PRE-EXISTING BUG, fixed here because we are already in this file: there
    // was no rule matching stores/{storeId}/*, so uploadStoreLogo() and
    // uploadReceiptLogo() in src/lib/firebase/client.ts fell through to the
    // deny-all root and have ALWAYS failed at runtime.
    //
    // Single-segment {fileName} on purpose, so this matches stores/{id}/logo.png
    // without shadowing the two deeper blocks above.
    match /stores/{storeId}/{fileName} {
      allow get;
      allow write: if request.auth != null
        && isStoreManagerOrAdmin(request.auth.uid, storeId)
        && isImageUnder(4);
    }
  }
}


rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // -- Helper Functions --
    // Cross-service Firestore reads from Storage rules must go through the
    // `firestore.` namespace. A bare get() is Firestore-rules syntax: the
    // compiler only warns ("Invalid function name: get"), but at evaluation
    // time the call fails and every rule depending on it falls through to
    // deny — which silently blocked the Items/ and loyaltyRewardImages/
    // uploads below.
    function getUserRole(uid) {
      return firestore.get(/databases/(default)/documents/staff/$(uid)).data.role;
    }
    
    function isManagerOrAdmin(uid) {
      let role = getUserRole(uid);
      return role == 'admin' || role == 'manager';
    }

    // Store-scoped variants. The role-only helper above is fine for global
    // assets (product images, loyalty rewards) but not for per-store uploads:
    // without the membership check, a manager at one branch could write into
    // another branch's folder. These mirror hasStoreAccess()/isManagerOrAdmin()
    // in firestore.rules, including the status == 'active' gate so a
    // deactivated account cannot keep uploading.
    function staffDataFor(uid) {
      return firestore.get(/databases/(default)/documents/staff/$(uid)).data;
    }

    function hasStoreAccess(uid, storeId) {
      let d = staffDataFor(uid);
      return d.status == 'active'
        && (d.role == 'admin'
            || (d.assignedStoreIds is list && d.assignedStoreIds.hasAny([storeId])));
    }

    function isStoreManagerOrAdmin(uid, storeId) {
      let d = staffDataFor(uid);
      return d.status == 'active'
        && (d.role == 'admin'
            || (d.role == 'manager'
                && d.assignedStoreIds is list
                && d.assignedStoreIds.hasAny([storeId])));
    }

    // Content-type and size gate. Without this, "upload an image" is really
    // "upload anything up to the bucket limit".
    function isImageUnder(maxMb) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < maxMb * 1024 * 1024;
    }

    // By default, allow public reads for images, but deny all writes.
    match /{allPaths=**} {
      allow read;
      allow write: if false;
    }

    // Allow a user to write/update their own avatar.
    match /users/{userId}/avatar.jpg {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow only managers or admins to upload product images.
    match /Items/{productId} {
      allow write: if request.auth != null && isManagerOrAdmin(request.auth.uid);
    }

    // Loyalty reward photos — managers/admins only.
    match /loyaltyRewardImages/{rewardId}/{fileName} {
      allow write: if request.auth != null && isManagerOrAdmin(request.auth.uid);
    }

    // Proposed product photos attached to a product-registration request.
    // Uploaded by the requesting manager before the request doc exists, under a
    // client-generated requestId; the approve op copies the resulting download
    // URL onto products/{id}.imageUrl and the store's inventory record.
    match /productRequestImages/{requestId}/{fileName} {
      allow write: if request.auth != null && isManagerOrAdmin(request.auth.uid);
    }

    // -- QR wallet (saved static merchant QRs) --
    // The captured photo of the QR, plus the fetched brand icon. Adding one
    // decides which account receives money, so manager/admin only — matching
    // savedQrCodes in firestore.rules.
    match /stores/{storeId}/qrWallet/{qrId}/{fileName} {
      allow write: if request.auth != null
        && isStoreManagerOrAdmin(request.auth.uid, storeId)
        && isImageUnder(6);
    }

    // -- Payment proofs --
    // Photo of the customer's e-wallet confirmation screen, taken after they
    // scan a saved QR. ANY active store staffer may write: this is the
    // CASHIER's flow, and gating it to managers would break it on the critical
    // path. No update/delete rule — a proof is immutable once written.
    //
    // TOP-LEVEL prefix ON PURPOSE, not stores/{storeId}/paymentProofs/. These
    // objects are deleted after 15 days by a Storage lifecycle rule, and
    // lifecycle rules match a LITERAL prefix — with the store id in the middle
    // of the path, no single prefix could target every store's proofs without
    // also matching that store's logo. See storage-lifecycle.json.
    //
    // NOTE: these photos show a customer's payment confirmation, and the public
    // root read below cannot be narrowed here (Storage rules OR across matching
    // blocks, so a stricter `allow read` accomplishes nothing). The mitigation
    // is the unguessable path: {proofId} is a crypto.randomUUID(), so 122 bits
    // makes enumeration infeasible, and the object is gone in 15 days anyway.
    match /paymentProofs/{storeId}/{fileName} {
      allow write: if request.auth != null
        && hasStoreAccess(request.auth.uid, storeId)
        && isImageUnder(6);
    }

    // -- Store logos --
    // PRE-EXISTING BUG, fixed here because we are already in this file: there
    // was no rule matching stores/{storeId}/*, so uploadStoreLogo() and
    // uploadReceiptLogo() in src/lib/firebase/client.ts fell through to the
    // deny-all root and have ALWAYS failed at runtime.
    //
    // Single-segment {fileName} on purpose, so this matches stores/{id}/logo.png
    // without shadowing the two deeper blocks above.
    match /stores/{storeId}/{fileName} {
      allow write: if request.auth != null
        && isStoreManagerOrAdmin(request.auth.uid, storeId)
        && isImageUnder(4);
    }
  }
}
